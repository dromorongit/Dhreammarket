  @@index([userId])
  @@index([isRead])
  @@map("order_messages")
}

model Session {
  id           String    @id @default(cuid())
  sessionId    String    @unique @db.VarChar(255)
  userId       String
  device       String?
  browser      String?
  os           String?
  ipAddress    String?
  location     String?
  userAgent    String?
  createdAt    DateTime  @default(now())
  lastActivity DateTime  @default(now())
  isExpired    Boolean   @default(false)
  expiredAt    DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@index([isExpired])
  @@map("sessions")
}

