# Email Service Feature Flag (set to true to enable email verification and password reset)
# During maintenance, set to false to bypass all email-dependent authentication flows
NEXT_PUBLIC_EMAIL_SERVICE_ENABLED=false

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/dhraverse"

# App URL (for callback URLs)
NEXT_PUBLIC_APP_URL="https://dhreamarket-production.up.railway.app"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Cloudinary (get from https://cloudinary.com/)
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Paystack Payment Gateway Keys (get from https://paystack.com/)
# Note: NEXT_PUBLIC_ prefix is REQUIRED for public key to be exposed to client bundle
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_your_public_key"
PAYSTACK_SECRET_KEY="sk_test_your_secret_key"
PAYSTACK_BASE_URL="https://api.paystack.co"

# Brevo Email Service (get from https://www.brevo.com/)
BREVO_API_KEY="your-brevo-api-key"
BREVO_SENDER_EMAIL="support@dhreamarket.com"
BREVO_SENDER_NAME="Dhream Market"
SUPPORT_EMAIL="support@dhreamarket.com"