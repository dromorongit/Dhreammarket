# Database
DATABASE_URL="postgresql://user:password@localhost:5432/dhreammarket"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Email (Brevo). lib/email.ts sends via api.brevo.com/v3/smtp/email.
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="support@dhreamarket.com"
ENABLE_WELCOME_EMAIL="false"

# Optional captcha
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# Trust profile (seller metrics). Enables /api/trust/sellers/[storeId] and the
# trust metrics shown on vendor pages. Defaults to off; turn on in development.
TRUST_PROFILE_ENABLED="false"

# Cron jobs. Secures POST /api/cron/*; send as Authorization: Bearer $CRON_SECRET.
CRON_SECRET=""

# Pay links. Turn on to enable the deployable pay-link flow.
PAYLINK_ENABLED="false"

# Client-facing pay link toggle (exposed to the browser).
NEXT_PUBLIC_PAYLINK_ENABLED="false"

# Fallback domain used to build recipient emails when a pay link has no buyer email.
PAYLINK_FALLBACK_EMAIL_DOMAIN=""

# Paystack secret key for pay-link payment initialization (get from https://paystack.com/).
PAYSTACK_SECRET_KEY=""

# Admin export (optional basic auth)
WAITLIST_EXPORT_TOKEN=""
PY
