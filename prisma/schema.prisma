model ServiceRequest {
  id                       String                          @id @default(cuid())
  referenceNumber          String                          @unique @db.VarChar(50)
  serviceId                String
  customerId               String
  vendorId                 String
  storeId                  String?
  title                    String
  description              String?
  preferredCompletionDate  DateTime?
  preferredBudget          Decimal?
  status                   ServiceRequestStatus            @default(PENDING)
  quotedPrice              Decimal?
  estimatedDuration        String?
  quotationNotes           String?
  quotationValidUntil      DateTime?
  acceptedAt               DateTime?
  cancelledAt              DateTime?
  completedAt              DateTime?
  createdAt                DateTime                        @default(now())
  updatedAt                DateTime                        @updatedAt
  service                  Service                         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  customer                 User                            @relation("ServiceRequestAsCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  vendor                   User                            @relation("ServiceRequestAsVendor", fields: [vendorId], references: [id], onDelete: Cascade)
  store                    Store?                          @relation(fields: [storeId], references: [id])
  attachments              ServiceRequestAttachment[]
  statusHistory            ServiceRequestStatusHistory[]
  quotations               ServiceQuotation[]

  @@map("service_requests")
  @@index([serviceId])
  @@index([customerId])
  @@index([vendorId])
  @@index([status])
  @@index([createdAt])
}

model ServiceRequestAttachment {
  id               String   @id @default(cuid())
  serviceRequestId String
  fileName         String
  fileUrl          String
  fileType         String
  fileSize         Int
  uploadedBy       String
  createdAt        DateTime @default(now())
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  uploader         User   @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@map("service_request_attachments")
  @@index([serviceRequestId])
}

model ServiceRequestStatusHistory {
  id               String                @id @default(cuid())
  serviceRequestId String
  status           ServiceRequestStatus
  changedBy        String
  notes            String?
  createdAt        DateTime              @default(now())
  serviceRequest   ServiceRequest        @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  changer          User                  @relation(fields: [changedBy], references: [id], onDelete: Cascade)

  @@map("service_request_status_history")
  @@index([serviceRequestId])
}

model ServiceQuotation {
  id                    String   @id @default(cuid())
  serviceRequestId      String
  vendorId              String
  quotedPrice           Decimal
  estimatedDuration     String?
  notes                 String?
  validUntil            DateTime
  status                String   @default("PENDING")
  acceptedAt            DateTime?
  rejectedAt            DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  serviceRequest        ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  vendor                User   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  attachments           QuotationAttachment[]

  @@map("service_quotations")
  @@index([serviceRequestId])
  @@index([vendorId])
}

model QuotationAttachment {
  id               String   @id @default(cuid())
  quotationId      String
  fileName         String
  fileUrl          String
  fileType         String
  fileSize         Int
  uploadedBy       String
  createdAt        DateTime @default(now())
  quotation        ServiceQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  uploader         User   @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@map("quotation_attachments")
  @@index([quotationId])
}

// ===== MODULE 1: Review Extensions =====

model ReviewImage {
