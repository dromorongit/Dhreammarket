{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true,
    "target": "es2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "downlevelIteration": true
  },
  "include": [
    "lib/support-ai-v2/**/*.ts",
    "app/api/support-ai/v2/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", "**/*.test.ts"]
}
