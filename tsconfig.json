{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "es2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "noEmit": true,
    "downlevelIteration": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@prisma/client": ["./node_modules/.prisma/client/index"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "lib/types.d.ts"],
  "exclude": ["node_modules", "_scripts", "scripts", ".kilo", ".next", "docs/archive/scripts/**/*", "**/*.test.ts", "**/*.test.tsx", "**/*.manual.test.ts", "coverage", "audit", "backups", "playwright", "test"]
}