  currentSlots        Int      @default(0) @map("current_slots")
  views               Int      @default(0)
  clicks              Int      @default(0)
  ordersGenerated     Int      @default(0) @map("orders_generated")
  bookingsGenerated   Int      @default(0) @map("bookings_generated")
  revenueGenerated    Float    @default(0) @map("revenue_generated")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  vendor              User     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  product             Product? @relation(fields: [selectedProductId], references: [id])
  service             Service? @relation(fields: [selectedServiceId], references: [id])
  placements          AdvertisementPlacement[]
  payments            AdvertisementPayment[]
  invoice             AdvertisementInvoice?
  analytics           AdvertisementAnalytics[]
  history             AdvertisementHistory[]

  @@map("advertisement_campaigns")
  @@index([vendorId])
  @@index([campaignStatus])
  @@index([paymentStatus])
  @@index([homepageSection])
  @@index([startDate])
  @@index([endDate])
}

model AdvertisementPlacement {
  id              String   @id @default(cuid())
  campaignId      String   @map("campaign_id")
  sectionSlug     String   @map("section_slug")
  productId       String?  @map("product_id")
  serviceId       String?  @map("service_id")
  displayOrder    Int     @default(0) @map("display_order")
  isSponsored     Boolean @default(true) @map("is_sponsored")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  campaign        AdvertisementCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("advertisement_placements")
  @@unique([campaignId, sectionSlug, productId])
  @@unique([campaignId, sectionSlug, serviceId])
  @@index([sectionSlug])
  @@index([isSponsored])
}

model AdvertisementPayment {
  id              String   @id @default(cuid())
  campaignId      String   @map("campaign_id")
  amount          Float
  currency        String   @default("GHS")
  paystackRef     String?  @map("paystack_ref")
  paystackPaymentId String? @map("paystack_payment_id")
  status          String   @default("PENDING")
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  campaign        AdvertisementCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("advertisement_payments")
  @@index([paystackRef])
  @@index([status])
  @@index([campaignId])
}

model AdvertisementInvoice {
  id              String   @id @default(cuid())
  campaignId      String   @unique @map("campaign_id")
  invoiceNumber   String   @unique @map("invoice_number")
  amount          Float
  currency        String   @default("GHS")
  periodStart     DateTime @map("period_start")
  periodEnd       DateTime @map("period_end")
  status          String   @default("PENDING")
  paystackInvoiceId String? @map("paystack_invoice_id")
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  campaign        AdvertisementCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("advertisement_invoices")
  @@index([invoiceNumber])
  @@index([status])
}

model AdvertisementAnalytics {
  id              String   @id @default(cuid())
  campaignId      String   @map("campaign_id")
  date            DateTime
  views           Int      @default(0)
  clicks          Int      @default(0)
  ordersGenerated Int      @default(0) @map("orders_generated")
  bookingsGenerated Int    @default(0) @map("bookings_generated")
  revenueGenerated Float   @default(0) @map("revenue_generated")
  ctr             Float    @default(0)
  conversionRate  Float    @default(0) @map("conversion_rate")
  roi             Float    @default(0)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  campaign        AdvertisementCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("advertisement_analytics")
  @@index([campaignId])
  @@index([date])
}

model AdvertisementHistory {
  id              String   @id @default(cuid())
  campaignId      String   @map("campaign_id")
  action          String   @map("action")
  performedBy     String   @map("performed_by") // userId
  performedByRole String   @map("performed_by_role")
  details         Json?
  createdAt       DateTime @default(now()) @map("created_at")
  campaign        AdvertisementCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("advertisement_history")
  @@index([campaignId])
  @@index([performedBy])
  @@index([createdAt])
}

enum AdvertisementCampaignType {
  SPONSORED_PRODUCT
  SPONSORED_SERVICE
  TRENDING_NOW_BOOST
  TRENDING_SERVICE_BOOST
  FEATURED_PRODUCT_PLACEMENT
  FEATURED_SERVICE_PLACEMENT
  SEARCH_RESULT_BOOST
  CATEGORY_BOOST
  VENDOR_SPOTLIGHT
}

enum AdvertisementCampaignStatus {
  PENDING_PAYMENT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ACTIVE
  EXPIRED
  CANCELLED
  SUSPENDED
}

enum AdvertisementCampaignAction {
  CREATED
  PAYMENT_INITIATED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  SUBMITTED_FOR_APPROVAL
  APPROVED
  REJECTED
  ACTIVATED
  SUSPENDED
  EXTENDED
  EXPIRED
  CANCELLED
  RENEWED
}
