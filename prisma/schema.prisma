generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                           String                         @id @default(cuid())
  email                        String                         @unique
  password                     String
  role                         Role                           @default(CUSTOMER)
  status                       UserStatus                     @default(ACTIVE)
  position                     String?
  createdAt                    DateTime                       @default(now())
  updatedAt                    DateTime                       @updatedAt
  resetPasswordToken           String?
  resetPasswordExpires         DateTime?
  emailVerifiedAt              DateTime?
  isEmailVerified              Boolean                        @default(false)
  behavioralTrackingConsent    Boolean                        @default(true)
  referralCode                 String?                        @unique @db.VarChar(32)
  registrationIpAddress        String?                        @db.VarChar(64)
  addresses                    Address[]
  adminSettings                AdminSettings?
  advertisementCampaigns       AdvertisementCampaign[]
  advertisements               Advertisement[]
  auditLogs                    AuditLog[]
  authTokens                   AuthToken[]
  cart                         Cart?
  feedbacks                    Feedback[]
  homepageSections             HomepageSectionVendor[]
  notifications                Notification[]
  orderMessages                OrderMessage[]
  orders                       Order[]
  paymentMethods               PaymentMethod[]
  payments                     Payment[]
  productReviews               ProductReview[]
  profile                      Profile?
  purchaseOrders               PurchaseOrder[]
  quotationAttachments         QuotationAttachment[]
  restockOrders                RestockOrder[]
  sentQuotations               ServiceQuotation[]
  uploadedAttachments          ServiceRequestAttachment[]
  statusHistoryEntries         ServiceRequestStatusHistory[]
  serviceRequestsAsCustomer    ServiceRequest[]               @relation("ServiceRequestAsCustomer")
  serviceRequestsAsVendor      ServiceRequest[]               @relation("ServiceRequestAsVendor")
  sessions                     Session[]
  store                        Store?
  assignedSupportConversations SupportConversation[]          @relation("AssignedSupportConversation")
  assignedSupportTickets       SupportTicket[]                @relation("AssignedSupportTicket")
  supportTickets               SupportTicket[]
  payoutMethods                VendorPayoutMethod[]
  vendorPayouts                VendorPayout[]                 @relation("VendorPayoutVendor")
  vendorReferral               VendorReferral?                @relation("UserVendorReferral")
  vendorReviews                VendorReview[]
  vendorSettings               VendorSettings?
  verificationApplications     VendorVerificationApplication?
  verificationAuditLogs        VerificationAuditLog[]
  wishlist                     Wishlist?

  @@index([referralCode])
  @@index([registrationIpAddress])
  @@map("users")
}

model PendingRegistration {
  id                    String   @id @default(cuid())
  email                 String   @unique
  hashedOTP             String
  otpExpiresAt          DateTime
  phone                 String?
  role                  Role
  position              String?
  name                  String?
  hashedPassword        String
  createdAt             DateTime @default(now())
  referralCode          String?  @db.VarChar(32)
  registrationIpAddress String?  @db.VarChar(64)
  marketingCode         String?

  @@index([email])
  @@index([otpExpiresAt])
  @@map("pending_registrations")
}

model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  tokenType TokenType
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  ipAddress String?
  userAgent String?
  selector  String?   @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, tokenType])
  @@index([userId, tokenType, expiresAt])
  @@index([expiresAt])
  @@map("auth_tokens")
}

model Profile {
  id                       String   @id @default(cuid())
  userId                   String   @unique
  firstName                String?
  lastName                 String?
  phone                    String?
  address                  String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  avatar                   String?
  darkMode                 Boolean  @default(false)
  language                 String?  @default("en")
  currency                 String?  @default("GHS")
  timezone                 String?  @default("Africa/Accra")
  emailNotifications       Boolean  @default(true)
  orderNotifications       Boolean  @default(true)
  promotionalNotifications Boolean  @default(false)
  systemNotifications      Boolean  @default(true)
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Store {
  id                       String                          @id @default(cuid())
  userId                   String                          @unique
  name                     String
  description              String?
  isVerified               Boolean                         @default(false)
  isFeatured               Boolean                         @default(false)
  featuredUntil            DateTime?
  logo                     String?
  banner                   String?
  categoryId               String?
  createdAt                DateTime                        @default(now())
  updatedAt                DateTime                        @updatedAt
  alternativePhoneNumber   String?
  mainPhoneNumber          String?
  whatsappNumber           String?
  averageRating            Float                           @default(0)
  reviewCount              Int                             @default(0)
  acceptsPreOrders         Boolean                         @default(false)
  acceptsBackOrders        Boolean                         @default(false)
  badgeTier                VendorBadgeTier?
  location                 String?
  slug                     String                          @unique
  address                  String?
  email                    String?
  canSellProducts          Boolean                         @default(true)
  canOfferServices         Boolean                         @default(false)
  setupComplete            Boolean?                        @default(false)
  products                 Product[]
  serviceRequests          ServiceRequest[]
  services                 Service[]
  vendor_categories        VendorCategory?                 @relation(fields: [categoryId], references: [id])
  user                     User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  payoutMethods            VendorPayoutMethod[]            @relation("VendorPayoutMethodStore")
  vendorPayouts            VendorPayout[]                  @relation("VendorPayoutStore")
  vendorReviews            VendorReview[]
  verificationApplications VendorVerificationApplication[]

  @@map("stores")
}

model VendorCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  stores    Store[]

  @@map("vendor_categories")
}

model ProductCategory {
  id                 String                      @id(map: "categories_pkey") @default(cuid())
  name               String
  parentId           String?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  slug               String?                     @unique(map: "categories_slug_key") @db.VarChar(255)
  isActive           Boolean                     @default(true)
  parent             ProductCategory?            @relation("ProductCategoryHierarchy", fields: [parentId], references: [id], map: "categories_parentId_fkey")
  children           ProductCategory[]           @relation("ProductCategoryHierarchy")
  productAssignments ProductCategoryAssignment[]
  products           Product[]

  @@map("product_categories")
}

model Brand {
  id               String                 @id @default(cuid())
  name             String                 @unique
  slug             String                 @unique
  logo             String?
  description      String?
  isActive         Boolean                @default(true)
  displayOrder     Int                    @default(0)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  homepageSections HomepageSectionBrand[]
  products         Product[]

  @@map("brands")
}

model Product {
  id                       String                      @id @default(cuid())
  storeId                  String
  categoryId               String
  name                     String
  description              String?
  brand                    String?
  price                    Float
  stock                    Int                         @default(0)
  reservedQuantity         Int                         @default(0)
  lowStockThreshold        Int                         @default(5)
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  averageRating            Float                       @default(0)
  reviewCount              Int                         @default(0)
  flashSalePrice           Float?
  flashSaleStart           DateTime?
  flashSaleEnd             DateTime?
  salesCount               Int                         @default(0)
  isSponsored              Boolean                     @default(false)
  brandId                  String?
  dealsPrice               Float?
  salesPrice               Float?
  availabilityType         ProductAvailabilityType     @default(IN_STOCK)
  expectedArrivalDate      DateTime?
  estimatedFulfillmentDays Int?
  preOrderNotes            String?
  expectedRestockDate      DateTime?
  backOrderNotes           String?
  slug                     String                      @unique
  dealsStart               DateTime?                   @db.Timestamp(6)
  dealsEnd                 DateTime?                   @db.Timestamp(6)
  isReturnable             Boolean                     @default(true)
  advertisements           Advertisement[]
  cartItems                CartItem[]
  homepageSections         HomepageSectionProduct[]
  orderItems               OrderItem[]
  categoryAssignments      ProductCategoryAssignment[]
  images                   ProductImage[]
  productReviews           ProductReview[]
  variants                 ProductVariant[]            @relation("ProductVariants")
  brandRelation            Brand?                      @relation(fields: [brandId], references: [id])
  category                 ProductCategory             @relation(fields: [categoryId], references: [id])
  store                    Store                       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  purchaseOrderItems       PurchaseOrderItem[]
  restockOrders            RestockOrder[]
  wishlistItems            WishlistItem[]

  @@index([storeId])
  @@index([categoryId])
  @@map("products")
}

model Service {
  id                       String             @id @default(cuid())
  vendorId                 String
  categoryId               String
  title                    String
  slug                     String             @unique
  description              String?
  shortDescription         String?
  startingPrice            Decimal            @default(0)
  pricingType              PricingType        @default(FIXED_PRICE)
  deliveryType             DeliveryType       @default(ONLINE)
  availabilityStatus       AvailabilityStatus @default(AVAILABLE)
  thumbnail                String?
  gallery                  String[]           @default([])
  isActive                 Boolean            @default(true)
  isFeatured               Boolean            @default(false)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  estimatedDeliveryTime    String?
  requirementsFromCustomer String?
  status                   ServiceStatus      @default(DRAFT)
  tags                     String[]           @default([])
  averageRating            Float              @default(0)
  reviewCount              Int                @default(0)
  images                   ServiceImage[]
  serviceRequests          ServiceRequest[]
  category                 ServiceCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  store                    Store              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  wishlistItems            WishlistItem[]

  @@index([vendorId])
  @@index([categoryId])
  @@map("services")
}

model ServiceCategory {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  description     String?
  icon            String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  displayOrder    Int       @default(0)
  isActive        Boolean   @default(true)
  isFeatured      Boolean   @default(false)
  banner          String?
  metaTitle       String?
  metaDescription String?
  services        Service[]

  @@map("service_categories")
}

model ServiceImage {
  id           String  @id @default(cuid())
  serviceId    String
  imageUrl     String
  displayOrder Int     @default(0)
  service      Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@map("service_images")
}

model ProductVariant {
  id               String      @id @default(cuid())
  productId        String
  color            String?
  size             String?
  age              String?
  sku              String?
  price            Float?
  stock            Int         @default(0)
  reservedQuantity Int         @default(0)
  active           Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  cartItems        CartItem[]
  orderItems       OrderItem[]
  product          Product     @relation("ProductVariants", fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_variants")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  createdAt DateTime @default(now())
  mediaType String   @default("image") @db.VarChar(20)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model ProductCategoryAssignment {
  id                String          @id @default(cuid())
  productId         String
  productCategoryId String
  isPrimary         Boolean         @default(false)
  createdAt         DateTime        @default(now())
  productCategory   ProductCategory @relation(fields: [productCategoryId], references: [id])
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, productCategoryId])
  @@map("product_category_assignments")
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("carts")
}

model CartItem {
  id               String          @id @default(cuid())
  cartId           String
  productId        String
  quantity         Int             @default(1)
  createdAt        DateTime        @default(now())
  age              String?
  color            String?
  productVariantId String?
  size             String?
  cart             Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id])

  @@unique([cartId, productId, productVariantId])
  @@map("cart_items")
}

model Wishlist {
  id                        String         @id @default(cuid())
  userId                    String         @unique
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
  notificationPreferences   Json?          @default("{}")
  privacyPreferences        Json?          @default("{}")
  recommendationPreferences Json?          @default("{}")
  items                     WishlistItem[]
  user                      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  productId  String?
  createdAt  DateTime @default(now())
  serviceId  String?
  product    Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  service    Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
  @@unique([wishlistId, serviceId])
  @@index([wishlistId])
  @@index([productId])
  @@index([serviceId])
  @@map("wishlist_items")
}

model Order {
  id                    String                 @id @default(cuid())
  userId                String
  grossAmount           Float?
  processorFee          Float?
  netAmount             Float?
  platformCommission    Float?
  vendorEarnings        Float?
  commissionRate        Float?
  total                 Float
  status                OrderStatus            @default(PENDING)
  paymentStatus         PaymentStatus          @default(PENDING)
  vendorAccepted        Boolean                @default(false)
  vendorRejected        Boolean                @default(false)
  vendorRejectionReason String?
  deletedAt             DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  customerAddress       String?
  customerCity          String?
  customerEmail         String?
  customerFirstName     String?
  customerLastName      String?
  customerPhone         String?
  customerRegion        String?
  shipping              Float?
  shippingDaysMax       Int?
  shippingDaysMin       Int?
  shippingZone          String?
  subtotal              Float?
  tax                   Float?
  orderType             OrderType              @default(NORMAL)
  fulfillmentStatus     OrderFulfillmentStatus @default(PENDING)
  inventoryConsumedAt   DateTime?
  allocatedAt           DateTime?
  idempotencyKey        String?
  walletAmountApplied   Float?
  fulfillmentEvents     FulfillmentEvent[]
  items                 OrderItem[]
  orderMessages         OrderMessage[]
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment               Payment?
  productReviews        ProductReview[]
  vendorReviews         VendorReview[]

  @@index([idempotencyKey], map: "idx_orders_idempotencyKey")
  @@index([walletAmountApplied])
  @@map("orders")
}

model OrderItem {
  id                  String                   @id @default(cuid())
  orderId             String
  productId           String
  quantity            Int
  price               Float
  grossAmount         Float?
  processorFee        Float?
  netAmount           Float?
  platformCommission  Float?
  vendorEarnings      Float?
  commissionRate      Float?
  createdAt           DateTime                 @default(now())
  age                 String?
  color               String?
  productVariantId    String?
  size                String?
  availabilityType    ProductAvailabilityType?
  expectedArrivalDate DateTime?
  expectedRestockDate DateTime?
  allocatedQuantity   Int                      @default(0)
  order               Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariant      ProductVariant?          @relation(fields: [productVariantId], references: [id])

  @@map("order_items")
}

model Payment {
  id          String        @id @default(cuid())
  userId      String
  orderId     String        @unique
  amount      Float
  currency    String        @default("GHS")
  status      PaymentStatus @default(PENDING)
  reference   String        @unique
  paystackRef String?
  message     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model ProductReview {
  id         String   @id @default(cuid())
  rating     Int
  comment    String?
  userId     String
  productId  String
  orderId    String?
  isApproved Boolean  @default(true)
  isHidden   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  order      Order?   @relation(fields: [orderId], references: [id])
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("product_reviews")
}

model VendorReview {
  id         String   @id @default(cuid())
  rating     Int
  comment    String?
  userId     String
  storeId    String
  orderId    String?
  isApproved Boolean  @default(true)
  isHidden   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  order      Order?   @relation(fields: [orderId], references: [id])
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@map("vendor_reviews")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Feedback {
  id        String       @id @default(cuid())
  userId    String
  type      FeedbackType
  subject   String
  message   String
  status    String       @default("OPEN")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("feedbacks")
}

model VendorPayout {
  id        String       @id @default(cuid())
  vendorId  String
  storeId   String
  amount    Float
  status    PayoutStatus
  reference String?
  note      String?
  paidAt    DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  store     Store        @relation("VendorPayoutStore", fields: [storeId], references: [id])
  vendor    User         @relation("VendorPayoutVendor", fields: [vendorId], references: [id])

  @@map("vendor_payouts")
}

model VendorPayoutMethod {
  id        String           @id @default(cuid())
  vendorId  String
  storeId   String
  type      PayoutMethodType @default(MOBILE_MONEY)
  details   Json             @default("{}")
  isDefault Boolean          @default(false)
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  store     Store            @relation("VendorPayoutMethodStore", fields: [storeId], references: [id], onDelete: NoAction)
  vendor    User             @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([storeId])
  @@map("vendor_payout_methods")
}

model VerificationSetting {
  id                              String   @id @default(cuid())
  verificationFee                 Float    @default(250.00)
  verificationEnabled             Boolean  @default(true)
  allowResubmissionAfterRejection Boolean  @default(true)
  autoExpirePendingApplications   Boolean  @default(false)
  expiryDays                      Int      @default(30)
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  @@map("verification_settings")
}

model VendorVerificationApplication {
  id                 String                 @id @default(cuid())
  vendorId           String                 @unique
  storeId            String
  status             VerificationStatus     @default(NOT_APPLIED)
  paymentReference   String?
  paymentStatus      String?                @default("UNPAID")
  paymentAmount      Float?
  paymentCompletedAt DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  paystackRef        String?
  store              Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  vendor             User                   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  kycInfo            VendorVerificationKYC?
  auditLogs          VerificationAuditLog[]
  documents          VerificationDocument[]
  payments           VerificationPayment?

  @@map("vendor_verification_applications")
}

model VendorVerificationKYC {
  id                         String                        @id @default(cuid())
  applicationId              String                        @unique
  businessName               String
  businessType               String
  businessRegistrationNumber String?
  tinNumber                  String?
  fullName                   String
  phoneNumber                String
  email                      String
  createdAt                  DateTime                      @default(now())
  updatedAt                  DateTime                      @updatedAt
  businessAddress            String?
  region                     String?
  city                       String?
  nationalIdType             String?
  nationalIdNumber           String?
  application                VendorVerificationApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("vendor_verification_kyc")
}

model VerificationDocument {
  id            String                        @id @default(cuid())
  applicationId String
  documentType  String
  documentUrl   String
  fileName      String?
  createdAt     DateTime                      @default(now())
  application   VendorVerificationApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("verification_documents")
}

model VerificationPayment {
  id            String                        @id @default(cuid())
  applicationId String                        @unique
  reference     String                        @unique
  amount        Float
  currency      String                        @default("GHS")
  status        String                        @default("UNPAID")
  paystackRef   String?
  createdAt     DateTime                      @default(now())
  updatedAt     DateTime                      @updatedAt
  completedAt   DateTime?
  application   VendorVerificationApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("verification_payments")
}

model VerificationAuditLog {
  id            String                        @id @default(cuid())
  applicationId String
  action        VerificationAction
  adminId       String?
  note          String?
  createdAt     DateTime                      @default(now())
  admin         User?                         @relation(fields: [adminId], references: [id], onDelete: Cascade)
  application   VendorVerificationApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("verification_audit_logs")
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  label     String?
  street    String
  region    String
  city      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model PaymentMethod {
  id        String   @id @default(cuid())
  userId    String
  type      String   @default("MOBILE_MONEY")
  details   Json     @default("{}")
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("payment_methods")
}

model VendorSettings {
  id                         String   @id @default(cuid())
  userId                     String   @unique
  defaultDashboardTab        String   @default("overview")
  compactView                Boolean  @default(false)
  autoRefresh                Boolean  @default(true)
  refreshInterval            Int      @default(30)
  dateFormat                 String   @default("MM/DD/YYYY")
  itemsPerPage               Int      @default(25)
  widgetVisibility           Json     @default("{}")
  productDisplayPreferences  Json     @default("{}")
  orderManagementPreferences Json     @default("{}")
  inventoryPreferences       Json     @default("{}")
  notifyNewOrders            Boolean  @default(true)
  notifyLowStock             Boolean  @default(true)
  notifyCustomerMessages     Boolean  @default(true)
  notifySettlements          Boolean  @default(true)
  notificationChannels       Json     @default("{}")
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("vendor_settings")
}

model AdminSettings {
  id                         String   @id @default(cuid())
  userId                     String   @unique
  defaultDashboardTab        String   @default("overview")
  compactView                Boolean  @default(false)
  autoRefresh                Boolean  @default(true)
  refreshInterval            Int      @default(30)
