generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String                  @id @default(cuid())
  email                String                  @unique
  password             String
  role                 Role                    @default(CUSTOMER)
  status               UserStatus              @default(ACTIVE)
  position             String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  cart                 Cart?
  feedbacks            Feedback[]
  homepageSections     HomepageSectionVendor[]
  notifications        Notification[]
  orders               Order[]
  payments             Payment[]
  profile              Profile?
  productReviews       ProductReview[]
  vendorReviews        VendorReview[]
  store                Store?
  supportTickets       SupportTicket[]
  vendorPayouts        VendorPayout[]          @relation("VendorPayoutVendor")

  @@map("users")
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  firstName String?
  lastName  String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Store {
  id                   String          @id @default(cuid())
  userId               String          @unique
  name                 String
  description          String?
  mainPhoneNumber      String?
  alternativePhoneNumber String?
  whatsappNumber       String?
  isVerified           Boolean         @default(false)
  isFeatured           Boolean         @default(false)
  featuredUntil        DateTime?
  logo                 String?
  banner               String?
  categoryId           String?
  averageRating        Float           @default(0)
  reviewCount          Int             @default(0)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  products             Product[]
  vendor_categories    VendorCategory? @relation(fields: [categoryId], references: [id])
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendorPayouts        VendorPayout[]  @relation("VendorPayoutStore")
  vendorReviews        VendorReview[]

  @@map("stores")
}

model VendorCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  stores    Store[]

  @@map("vendor_categories")
}

model ProductCategory {
  id        String            @id(map: "categories_pkey") @default(cuid())
  name      String
  parentId  String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  slug      String?           @unique(map: "categories_slug_key") @db.VarChar(255)
  isActive  Boolean           @default(true)
  parent    ProductCategory?  @relation("ProductCategoryHierarchy", fields: [parentId], references: [id], map: "categories_parentId_fkey")
  children  ProductCategory[] @relation("ProductCategoryHierarchy")
  products  Product[]
  productAssignments ProductCategoryAssignment[]

  @@map("product_categories")
}

model Brand {
  id           String    @id @default(cuid())
  name         String    @unique
  slug         String    @unique
  logo         String?
  description  String?
  isActive     Boolean   @default(true)
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  products     Product[]
  homepageSections HomepageSectionBrand[]

  @@map("brands")
}

model Product {
  id               String                   @id @default(cuid())
  storeId          String
  categoryId       String
  name             String
  description      String?
  brand            String?
  brandId          String?
  price            Float
  flashSalePrice   Float?                   // Discounted price for flash sales
  flashSaleStart   DateTime?                // When flash sale starts
  flashSaleEnd     DateTime?                // When flash sale ends
  salesCount       Int                      @default(0) // Total units sold
  isSponsored      Boolean                  @default(false) // Sponsored/promoted products
  stock            Int                      @default(0)
  averageRating    Float                    @default(0)
  reviewCount      Int                      @default(0)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  cartItems        CartItem[]
  homepageSections HomepageSectionProduct[]
  orderItems       OrderItem[]
  images           ProductImage[]
  category         ProductCategory          @relation(fields: [categoryId], references: [id])
  store            Store                    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  brandRelation    Brand?                   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  productReviews   ProductReview[]
  categoryAssignments ProductCategoryAssignment[]

  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model ProductCategoryAssignment {
  id               String         @id @default(cuid())
  productId        String
  productCategoryId String
  isPrimary        Boolean        @default(false)
  createdAt        DateTime       @default(now())
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  productCategory  ProductCategory @relation(fields: [productCategoryId], references: [id])

  @@unique([productId, productCategoryId])
  @@map("product_category_assignments")
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Order {
  id                 String        @id @default(cuid())
  userId             String
  grossAmount        Float?
  processorFee       Float?
  netAmount          Float?
  platformCommission Float?
  vendorEarnings     Float?
  commissionRate     Float?
  total              Float
  subtotal           Float?
  shipping           Float?
  tax                Float?
  status             OrderStatus   @default(PENDING)
  paymentStatus      PaymentStatus @default(PENDING)
  deletedAt          DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  // Customer information
  customerFirstName  String?
  customerLastName   String?
  customerEmail      String?
  customerPhone      String?
  customerAddress    String?
  customerCity       String?
  customerRegion     String?
  // Shipping information
  shippingZone       String?
  shippingDaysMin    Int?
  shippingDaysMax    Int?
  items              OrderItem[]
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment            Payment?
  productReviews     ProductReview[]
  vendorReviews      VendorReview[]

  @@map("orders")
}

model OrderItem {
  id                 String   @id @default(cuid())
  orderId            String
  productId          String
  storeId            String?
  quantity           Int
  price              Float
  grossAmount        Float?
  processorFee       Float?
  netAmount          Float?
  platformCommission Float?
  vendorEarnings     Float?
  commissionRate     Float?
  createdAt          DateTime @default(now())
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model Payment {
  id          String        @id @default(cuid())
  userId      String
  orderId     String        @unique
  amount      Float
  currency    String        @default("GHS")
  status      PaymentStatus @default(PENDING)
  reference   String        @unique
  paystackRef String?
  message     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  order       Order         @relation(fields: [orderId], references: [id])
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model ProductReview {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  userId    String
  productId String
  orderId   String?
  isApproved Boolean  @default(true)
  isHidden  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  order   Order?  @relation(fields: [orderId], references: [id])

  @@unique([userId, productId])
  @@map("product_reviews")
}

model VendorReview {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  userId    String
  storeId   String
  orderId   String?
  isApproved Boolean  @default(true)
  isHidden  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  store Store @relation(fields: [storeId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])

  @@unique([userId, storeId])
  @@map("vendor_reviews")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Feedback {
  id        String       @id @default(cuid())
  userId    String
  type      FeedbackType
  subject   String
  message   String
  status    String       @default("OPEN")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("feedbacks")
}

model VendorPayout {
  id        String       @id @default(cuid())
  vendorId  String
  storeId   String
  amount    Float
  status    PayoutStatus
  reference String?
  note      String?
  paidAt    DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  store     Store        @relation("VendorPayoutStore", fields: [storeId], references: [id])
  vendor    User         @relation("VendorPayoutVendor", fields: [vendorId], references: [id])

  @@map("vendor_payouts")
}

model SupportTicket {
  id         String                @id @default(cuid())
  userId     String
  subject    String
  message    String
  type       SupportTicketType
  status     SupportTicketStatus   @default(OPEN)
  priority   SupportTicketPriority @default(MEDIUM)
  adminReply String?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("support_tickets")
}

model HomepageSection {
  id           String                   @id @default(cuid())
  name         String
  slug         String                   @unique
  isEnabled    Boolean                  @default(true)
  displayOrder Int                      @default(0)
  type         HomepageSectionType
  subtitle     String?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  products     HomepageSectionProduct[]
  vendors      HomepageSectionVendor[]
  brands       HomepageSectionBrand[]

  @@map("homepage_sections")
}

model HomepageSectionProduct {
  id           String          @id @default(cuid())
  sectionId    String
  productId    String
  displayOrder Int             @default(0)
  createdAt    DateTime        @default(now())
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  section      HomepageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, productId])
  @@map("homepage_section_products")
}

model HomepageSectionVendor {
  id        String          @id @default(cuid())
  sectionId String
  vendorId  String
  createdAt DateTime        @default(now())
  section   HomepageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  vendor    User            @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([sectionId, vendorId])
  @@map("homepage_section_vendors")
}

model HomepageSectionBrand {
  id        String          @id @default(cuid())
  sectionId String
  brandId   String
  createdAt DateTime        @default(now())
  section   HomepageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  brand     Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([sectionId, brandId])
  @@map("homepage_section_brands")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  VENDOR
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  BANNED
  DISABLED
  SUSPENDED
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum NotificationType {
  ORDER_PLACED
  PAYMENT_SUCCESSFUL
  ORDER_STATUS_UPDATED
  REVIEW_SUBMITTED
  REVIEW_RECEIVED
  SUPPORT_TICKET_CREATED
  SUPPORT_TICKET_REPLIED
  SUPPORT_TICKET_STATUS_UPDATED
}

enum FeedbackType {
  SUGGESTION
  BUG_REPORT
  GENERAL
  QUESTION
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

enum SupportTicketType {
  GENERAL
  PAYMENT
  ORDER
  VENDOR
  ACCOUNT
  TECHNICAL
  REPORT
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum HomepageSectionType {
  PRODUCT_GRID
  QUICKLINK_CARD_GRID
  LARGE_FEATURE_CARDS
  BRAND_GRID
  SERVICE_GRID
  FLASH_SALES
  SPONSORED_PRODUCTS
  TOP_SELLING
  BIG_DEALS
}
