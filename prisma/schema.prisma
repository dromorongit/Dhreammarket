  billingCycle    String   @default("MONTHLY") @map("billing_cycle")
  currentPeriodStart DateTime @map("current_period_start")
  currentPeriodEnd   DateTime @map("current_period_end")
  nextRenewalAt   DateTime @map("next_renewal_at")
  trialEndsAt     DateTime? @map("trial_ends_at")
  cancelledAt     DateTime? @map("cancelled_at")
  cancelledAtPeriodEnd Boolean @default(false) @map("cancelled_at_period_end")
  autoRenew       Boolean  @default(false) @map("auto_renew")
  paystackCustomerId String? @map("paystack_customer_id")
  paystackSubscriptionId String? @map("paystack_subscription_id")
  totalPaid       Float    @default(0) @map("total_paid")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  vendor          User     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  plan            SubscriptionPlan @relation(fields: [planId], references: [id])
  invoices        SubscriptionInvoice[]
  payments        SubscriptionPayment[]
  usageRecords    SubscriptionUsage[]
  history         SubscriptionHistory[]

  @@map("vendor_subscriptions")
  @@unique([vendorId])
  @@index([planId])
  @@index([status])
  @@index([currentPeriodEnd])
  @@index([nextRenewalAt])
