generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String                         @id @default(cuid())
  email                    String                         @unique
  password                 String
  role                     Role                           @default(CUSTOMER)
  status                   UserStatus                     @default(ACTIVE)
  position                 String?
  createdAt                DateTime                       @default(now())
  updatedAt                DateTime                       @updatedAt
  resetPasswordToken       String?
  resetPasswordExpires     DateTime?
  emailVerifiedAt          DateTime?
  isEmailVerified          Boolean                        @default(false)
  auditLogs                AuditLog[]
  authTokens               AuthToken[]
  cart                     Cart?
  feedbacks                Feedback[]
  homepageSections         HomepageSectionVendor[]
  notifications            Notification[]
  orderMessages            OrderMessage[]
  orders                   Order[]
  payments                 Payment[]
  productReviews           ProductReview[]
  profile                  Profile?
  purchaseOrders           PurchaseOrder[]
  restockOrders            RestockOrder[]
  store                    Store?
  supportTickets           SupportTicket[]
  vendorPayouts            VendorPayout[]                 @relation("VendorPayoutVendor")
  vendorReviews            VendorReview[]
  verificationApplications VendorVerificationApplication?
  verificationAuditLogs    VerificationAuditLog[]

  @@map("users")
}

model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  tokenType TokenType
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  ipAddress String?
  userAgent String?
  selector  String?   @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, tokenType])
  @@index([userId, tokenType, expiresAt])
  @@index([expiresAt])
  @@map("auth_tokens")
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  firstName String?
  lastName  String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Store {
  id                       String                          @id @default(cuid())
  userId                   String                          @unique
  name                     String
  slug                     String                          @unique
  description              String?
  isVerified               Boolean                         @default(false)
  isFeatured               Boolean                         @default(false)
  featuredUntil            DateTime?
  logo                     String?
  banner                   String?
  categoryId               String?
  location                 String?
  createdAt                DateTime                        @default(now())
  updatedAt                DateTime                        @updatedAt
  alternativePhoneNumber   String?
  mainPhoneNumber          String?
  whatsappNumber           String?
  averageRating            Float                           @default(0)
  reviewCount              Int                             @default(0)
  acceptsPreOrders         Boolean                         @default(false)
  acceptsBackOrders        Boolean                         @default(false)
  badgeTier                VendorBadgeTier?
  products                 Product[]
  vendor_categories        VendorCategory?                 @relation(fields: [categoryId], references: [id])
  user                     User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendorPayouts            VendorPayout[]                  @relation("VendorPayoutStore")
  vendorReviews            VendorReview[]
  verificationApplications VendorVerificationApplication[]

  @@map("stores")
}

model VendorCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  stores    Store[]

  @@map("vendor_categories")
}

model ProductCategory {
  id                 String                      @id(map: "categories_pkey") @default(cuid())
  name               String
  parentId           String?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  slug               String?                     @unique(map: "categories_slug_key") @db.VarChar(255)
  isActive           Boolean                     @default(true)
  parent             ProductCategory?            @relation("ProductCategoryHierarchy", fields: [parentId], references: [id], map: "categories_parentId_fkey")
  children           ProductCategory[]           @relation("ProductCategoryHierarchy")
  productAssignments ProductCategoryAssignment[]
  products           Product[]

  @@map("product_categories")
}

model Brand {
  id               String                 @id @default(cuid())
  name             String                 @unique
  slug             String                 @unique
  logo             String?
  description      String?
  isActive         Boolean                @default(true)
  displayOrder     Int                    @default(0)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  homepageSections HomepageSectionBrand[]
  products         Product[]

  @@map("brands")
}

model Product {
  id                       String                      @id @default(cuid())
  storeId                  String
  categoryId               String
  name                     String
  slug                     String                      @unique
  description              String?
  brand                    String?
  price                    Float
  stock                    Int                         @default(0)
  reservedQuantity         Int                         @default(0)
  lowStockThreshold        Int                         @default(5)
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  averageRating            Float                       @default(0)
  reviewCount              Int                         @default(0)
  flashSalePrice           Float?
  flashSaleStart           DateTime?
  flashSaleEnd             DateTime?
  salesCount               Int                         @default(0)
  isSponsored              Boolean                     @default(false)
  brandId                  String?
  dealsPrice               Float?
  salesPrice               Float?
  availabilityType         ProductAvailabilityType     @default(IN_STOCK)
  expectedArrivalDate      DateTime?
  estimatedFulfillmentDays Int?
  preOrderNotes            String?
  expectedRestockDate      DateTime?
  backOrderNotes           String?
  cartItems                CartItem[]
  homepageSections         HomepageSectionProduct[]
  orderItems               OrderItem[]
  categoryAssignments      ProductCategoryAssignment[]
  images                   ProductImage[]
  productReviews           ProductReview[]
  variants                 ProductVariant[]            @relation("ProductVariants")
  brandRelation            Brand?                      @relation(fields: [brandId], references: [id])
  category                 ProductCategory             @relation(fields: [categoryId], references: [id])
  store                    Store                       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  purchaseOrderItems       PurchaseOrderItem[]
  restockOrders            RestockOrder[]

  @@map("products")
}

model ProductVariant {
  id               String      @id @default(cuid())
  productId        String
  color            String?
  size             String?
  age              String?
  sku              String?
  stock            Int         @default(0)
  reservedQuantity Int         @default(0)
  active           Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  cartItems        CartItem[]
  orderItems       OrderItem[]
  product          Product     @relation("ProductVariants", fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_variants")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model ProductCategoryAssignment {
  id                String          @id @default(cuid())
  productId         String
  productCategoryId String
  isPrimary         Boolean         @default(false)
  createdAt         DateTime        @default(now())
  productCategory   ProductCategory @relation(fields: [productCategoryId], references: [id])
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, productCategoryId])
  @@map("product_category_assignments")
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("carts")
}

model CartItem {
  id               String          @id @default(cuid())
  cartId           String
  productId        String
  quantity         Int             @default(1)
  createdAt        DateTime        @default(now())
  age              String?
  color            String?
  productVariantId String?
  size             String?
  cart             Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id])

  @@unique([cartId, productId, productVariantId])
  @@map("cart_items")
}

model Order {
  id                    String                 @id @default(cuid())
  userId                String
  grossAmount           Float?
  processorFee          Float?
  netAmount             Float?
  platformCommission    Float?
  vendorEarnings        Float?
  commissionRate        Float?
  total                 Float
  status                OrderStatus            @default(PENDING)
  paymentStatus         PaymentStatus          @default(PENDING)
  vendorAccepted        Boolean                @default(false)
  vendorRejected        Boolean                @default(false)
  vendorRejectionReason String?
  deletedAt             DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  customerAddress       String?
  customerCity          String?
  customerEmail         String?
  customerFirstName     String?
  customerLastName      String?
  customerPhone         String?
  customerRegion        String?
  shipping              Float?
  shippingDaysMax       Int?
  shippingDaysMin       Int?
  shippingZone          String?
  subtotal              Float?
  tax                   Float?
  orderType             OrderType              @default(NORMAL)
  fulfillmentStatus     OrderFulfillmentStatus @default(PENDING)
  inventoryConsumedAt   DateTime?
  allocatedAt           DateTime?
  fulfillmentEvents     FulfillmentEvent[]
  items                 OrderItem[]
  orderMessages         OrderMessage[]
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment               Payment?
  productReviews        ProductReview[]
  vendorReviews         VendorReview[]

  @@map("orders")
}

model OrderItem {
  id                  String                   @id @default(cuid())
  orderId             String
  productId           String
  quantity            Int
  price               Float
  grossAmount         Float?
  processorFee        Float?
  netAmount           Float?
  platformCommission  Float?
  vendorEarnings      Float?
  commissionRate      Float?
  createdAt           DateTime                 @default(now())
  age                 String?
  color               String?
  productVariantId    String?
  size                String?
  availabilityType    ProductAvailabilityType?
  expectedArrivalDate DateTime?
  expectedRestockDate DateTime?
  allocatedQuantity   Int                      @default(0)
  order               Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariant      ProductVariant?          @relation(fields: [productVariantId], references: [id])

  @@map("order_items")
}

model Payment {
  id          String        @id @default(cuid())
  userId      String
  orderId     String        @unique
  amount      Float
  currency    String        @default("GHS")
  status      PaymentStatus @default(PENDING)
  reference   String        @unique
  paystackRef String?
  message     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model ProductReview {
  id         String   @id @default(cuid())
  rating     Int
  comment    String?
  userId     String
  productId  String
  orderId    String?
  isApproved Boolean  @default(true)
  isHidden   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  order      Order?   @relation(fields: [orderId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("product_reviews")
}

model VendorReview {
  id         String   @id @default(cuid())
  rating     Int
  comment    String?
  userId     String
  storeId    String
  orderId    String?
  isApproved Boolean  @default(true)
  isHidden   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  order      Order?   @relation(fields: [orderId], references: [id])
  store      Store    @relation(fields: [storeId], references: [id])
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@map("vendor_reviews")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Feedback {
  id        String       @id @default(cuid())
  userId    String
  type      FeedbackType
  subject   String
  message   String
  status    String       @default("OPEN")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("feedbacks")
}

model VendorPayout {
  id        String       @id @default(cuid())
  vendorId  String
  storeId   String
  amount    Float
  status    PayoutStatus
  reference String?
  note      String?
  paidAt    DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  store     Store        @relation("VendorPayoutStore", fields: [storeId], references: [id])
  vendor    User         @relation("VendorPayoutVendor", fields: [vendorId], references: [id])

  @@map("vendor_payouts")
}

model VerificationSetting {
  id                              String   @id @default(cuid())
  verificationFee                 Float    @default(250.00)
  verificationEnabled             Boolean  @default(true)
  allowResubmissionAfterRejection Boolean  @default(true)
  autoExpirePendingApplications   Boolean  @default(false)
  expiryDays                      Int      @default(30)
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  @@map("verification_settings")
}

model VendorVerificationApplication {
  id                 String                 @id @default(cuid())
  vendorId           String                 @unique
  storeId            String
  status             VerificationStatus     @default(NOT_APPLIED)
  paymentReference   String?
  paymentStatus      String?                @default("UNPAID")
  paymentAmount      Float?
  paymentCompletedAt DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  paystackRef        String?
  store              Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  vendor             User                   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  kycInfo            VendorVerificationKYC?
  auditLogs          VerificationAuditLog[]
  documents          VerificationDocument[]
  payments           VerificationPayment?

  @@map("vendor_verification_applications")
}

model VendorVerificationKYC {
  id                         String                        @id @default(cuid())
  applicationId              String                        @unique
  businessName               String
  businessType               String
  businessRegistrationNumber String?
  tinNumber                  String?
  fullName                   String
  phoneNumber                String
  email                      String
  createdAt                  DateTime                      @default(now())
  updatedAt                  DateTime                      @updatedAt
  businessAddress            String?
  region                     String?
  city                       String?
  nationalIdType             String?
  nationalIdNumber           String?
  application                VendorVerificationApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("vendor_verification_kyc")
}

model VerificationDocument {
  id            String                        @id @default(cuid())
  applicationId String
  documentType  String
  documentUrl   String
  fileName      String?
  createdAt     DateTime                      @default(now())
  application   VendorVerificationApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("verification_documents")
}

model VerificationPayment {
  id            String                        @id @default(cuid())
  applicationId String                        @unique
  reference     String                        @unique
  amount        Float
  currency      String                        @default("GHS")
  status        String                        @default("UNPAID")
  paystackRef   String?
  createdAt     DateTime                      @default(now())
  updatedAt     DateTime                      @updatedAt
  completedAt   DateTime?
  application   VendorVerificationApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("verification_payments")
}

model VerificationAuditLog {
  id            String                        @id @default(cuid())
  applicationId String
  action        VerificationAction
  adminId       String?
  note          String?
  createdAt     DateTime                      @default(now())
  admin         User?                         @relation(fields: [adminId], references: [id], onDelete: Cascade)
  application   VendorVerificationApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("verification_audit_logs")
}

model SupportTicket {
  id         String                @id @default(cuid())
  userId     String?
  subject    String
  message    String
  type       SupportTicketType
  status     SupportTicketStatus   @default(OPEN)
  priority   SupportTicketPriority @default(MEDIUM)
  adminReply String?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  user       User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("support_tickets")
}

model HomepageSection {
  id           String                   @id @default(cuid())
  name         String
  slug         String                   @unique
  isEnabled    Boolean                  @default(true)
  displayOrder Int                      @default(0)
  type         HomepageSectionType
  subtitle     String?
  settings     Json?                    @default("{}")
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  brands       HomepageSectionBrand[]
  products     HomepageSectionProduct[]
  vendors      HomepageSectionVendor[]

  @@map("homepage_sections")
}

model HomepageSectionProduct {
  id           String          @id @default(cuid())
  sectionId    String
  productId    String
  createdAt    DateTime        @default(now())
  displayOrder Int             @default(0)
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  section      HomepageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, productId])
  @@map("homepage_section_products")
}

model HomepageSectionVendor {
  id        String          @id @default(cuid())
  sectionId String
  vendorId  String
  createdAt DateTime        @default(now())
  section   HomepageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  vendor    User            @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([sectionId, vendorId])
  @@map("homepage_section_vendors")
}

model HomepageSectionBrand {
  id        String          @id @default(cuid())
  sectionId String
  brandId   String
  createdAt DateTime        @default(now())
  brand     Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  section   HomepageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, brandId])
  @@map("homepage_section_brands")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  userRole   String
  action     String
  entityType String
  entityId   String?
  beforeData Json?
  afterData  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model RestockOrder {
  id                  String             @id @default(cuid())
  productId           String
  vendorId            String
  quantityOrdered     Int                @default(0)
  quantityReceived    Int                @default(0)
  status              RestockOrderStatus @default(ORDERED)
  expectedArrivalDate DateTime?
  actualArrivalDate   DateTime?
  notes               String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  purchaseOrderId     String?
  product             Product            @relation(fields: [productId], references: [id])
  purchaseOrder       PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id])
  vendor              User               @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([productId])
  @@index([status])
  @@map("restock_orders")
}

model Supplier {
  id             String             @id @default(cuid())
  companyName    String
  contactPerson  String?
  email          String?
  phone          String?
  address        String?
  country        String?
  notes          String?
  status         SupplierStatus     @default(ACTIVE)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  purchaseOrders PurchaseOrder[]
  documents      SupplierDocument[]

  @@map("suppliers")
}

model SupplierDocument {
  id           String               @id @default(cuid())
  supplierId   String
  documentType SupplierDocumentType
  documentUrl  String
  fileName     String?
  fileSize     Int?
  mimeType     String?
  metadata     Json?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  supplier     Supplier             @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([documentType])
  @@map("supplier_documents")
}

model PurchaseOrder {
  id                  String              @id @default(cuid())
  supplierId          String
  vendorId            String
  poNumber            String?             @unique
  expectedArrivalDate DateTime?
  notes               String?
  status              PurchaseOrderStatus @default(DRAFT)
  totalCost           Float               @default(0)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @default(now())
  actualArrivalDate   DateTime?
  receivedAt          DateTime?
  items               PurchaseOrderItem[]
  supplier            Supplier            @relation(fields: [supplierId], references: [id])
  vendor              User                @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  restockOrders       RestockOrder[]

  @@index([supplierId])
  @@index([vendorId])
  @@index([status])
  @@index([createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  productId       String
  quantity        Int           @default(1)
  unitCost        Float         @default(0)
  totalCost       Float         @default(0)
  createdAt       DateTime      @default(now())
  product         Product       @relation(fields: [productId], references: [id])
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

model FulfillmentEvent {
  id          String   @id @default(cuid())
  orderId     String
  eventType   String
  title       String
  description String?
  createdBy   String?
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([eventType])
  @@index([createdAt])
  @@map("fulfillment_events")
}

model OrderMessage {
  id          String      @id @default(cuid())
  orderId     String
  userId      String
  userRole    String
  message     String
  messageType MessageType @default(GENERAL)
  isRead      Boolean     @default(false)
  createdAt   DateTime    @default(now())
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([userId])
  @@index([isRead])
  @@map("order_messages")
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  OTP_LOGIN
  OTP_MFA
}

enum Role {
  SUPER_ADMIN
  ADMIN
  VENDOR
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  BANNED
  DISABLED
  SUSPENDED
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum NotificationType {
  ORDER_PLACED
  PAYMENT_SUCCESSFUL
  ORDER_STATUS_UPDATED
  REVIEW_SUBMITTED
  REVIEW_RECEIVED
  SUPPORT_TICKET_CREATED
  SUPPORT_TICKET_REPLIED
  SUPPORT_TICKET_STATUS_UPDATED
  RESTOCK_ORDER_CREATED
  RESTOCK_ORDER_OVERDUE
  RESTOCK_INVENTORY_RECEIVED
  ORDER_CANCELLED
}

enum FeedbackType {
  SUGGESTION
  BUG_REPORT
  GENERAL
  QUESTION
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

enum SupportTicketType {
  GENERAL
  PAYMENT
  ORDER
  VENDOR
  ACCOUNT
  TECHNICAL
  REPORT
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum HomepageSectionType {
  PRODUCT_GRID
  QUICKLINK_CARD_GRID
  LARGE_FEATURE_CARDS
  BRAND_GRID
  SERVICE_GRID
  FLASH_SALES
