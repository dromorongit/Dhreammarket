model ReviewVideo {
  id        String   @id @default(cuid())
  reviewId  String
  url       String
  thumbnail String?
  createdAt DateTime @default(now())
  review    ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("review_videos")
  @@index([reviewId])
}

model ReviewLike {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String
  createdAt DateTime @default(now())
  review    ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@map("review_likes")
  @@index([reviewId])
  @@index([userId])
}

model ReviewReport {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String
  reason    String
  comment   String?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  review    ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("review_reports")
  @@index([reviewId])
  @@index([userId])
}

model VendorReply {
  id        String   @id @default(cuid())
  reviewId  String   @unique
  vendorId  String
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  review    ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  vendor    User     @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("vendor_replies")
  @@index([reviewId])
  @@index([vendorId])
}

model ServiceReview {
  id         String   @id @default(cuid())
  rating     Int
  comment    String?
  userId     String
  serviceId  String
  requestId  String?
  isApproved Boolean  @default(true)
  isHidden   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes      ServiceReviewLike[]

  @@unique([userId, serviceId])
  @@map("service_reviews")
  @@index([serviceId])
  @@index([userId])
  @@index([requestId])
}

model ServiceReviewLike {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String
  createdAt DateTime @default(now())
  review    ServiceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@map("service_review_likes")
  @@index([reviewId])
  @@index([userId])
}

model VendorReviewReply {
  id        String   @id @default(cuid())
  reviewId  String
  vendorId  String
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  review    VendorReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  vendor    User     @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("vendor_review_replies")
  @@index([reviewId])
  @@index([vendorId])
}

// ===== MODULE 2: Collections =====

model Collection {
  id          String   @id @default(cuid())
  userId      String
  name        String
  slug        String   @unique
  description String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       CollectionItem[]

  @@map("collections")
  @@index([userId])
  @@index([slug])
}

model CollectionItem {
  id           String   @id @default(cuid())
  collectionId String
  productId    String?
  serviceId    String?
  createdAt    DateTime @default(now())
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  service      Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([collectionId, productId])
  @@unique([collectionId, serviceId])
  @@map("collection_items")
  @@index([collectionId])
  @@index([productId])
  @@index([serviceId])
}

// ===== MODULE 3: Recently Viewed =====

model RecentlyViewed {
  id        String   @id @default(cuid())
  userId    String
  entityType String  // "PRODUCT" | "SERVICE" | "VENDOR"
  entityId  String
  viewedAt  DateTime @default(now())

  @@map("recently_viewed")
  @@index([userId])
  @@index([entityType, entityId])
  @@index([viewedAt])
}

model SearchHistory {
  id         String   @id @default(cuid())
  userId     String
  query      String
  searchedAt DateTime @default(now())

  @@map("search_history")
  @@index([userId])
  @@index([searchedAt])
}

// ===== MODULE 4: Recommendations =====

model Recommendation {
  id         String   @id @default(cuid())
  userId     String
  entityType String   // "PRODUCT" | "SERVICE" | "VENDOR"
  entityId   String
  reason     String   // "VIEWED" | "PURCHASED" | "LIKED" | "TRENDING"
  score      Float    @default(0)
  createdAt  DateTime @default(now())

  @@map("recommendations")
  @@index([userId])
  @@index([entityType, entityId])
}

// ===== MODULE 5: Compare Products =====

model ProductCompare {
  id        String   @id @default(cuid())
